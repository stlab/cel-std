# Runs an independent source or installed consumer; any failed command is fatal.
# Complexity: O(consumer configuration, compilation, and execution).
function(run)
    execute_process(COMMAND ${ARGV} COMMAND_ERROR_IS_FATAL ANY)
endfunction()

set(root "@CMAKE_CURRENT_BINARY_DIR@/consumer-${MODE}")
set(options
    "-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@"
    "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@"
    "-DCMAKE_CXX_FLAGS=@CMAKE_CXX_FLAGS@"
    "-DCMAKE_EXE_LINKER_FLAGS=@CMAKE_EXE_LINKER_FLAGS@")
set(build_config)
set(test_config)
if(CONFIG)
    list(APPEND build_config --config "${CONFIG}")
    list(APPEND test_config -C "${CONFIG}")
endif()

if(MODE STREQUAL "source")
    list(APPEND options "-DCEL_STD_SOURCE_DIR=@CMAKE_CURRENT_SOURCE_DIR@"
        "-DBUILD_TESTING=OFF" "-DCEL_INSTALL=OFF")
elseif(MODE STREQUAL "installed")
    run("@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@"
        ${build_config} --prefix "${root}/prefix")
    list(APPEND options
        "-DCMAKE_PREFIX_PATH=${root}/prefix"
        "-DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF"
        "-DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF")
else()
    message(FATAL_ERROR "Unknown consumer mode: ${MODE}")
endif()

run("@CMAKE_COMMAND@" -S "@CMAKE_CURRENT_SOURCE_DIR@/tests/consumer"
    -B "${root}/build" -G "@CMAKE_GENERATOR@" ${options})
run("@CMAKE_COMMAND@" --build "${root}/build" ${build_config} --parallel 2)
run("@CMAKE_CTEST_COMMAND@" --test-dir "${root}/build"
    ${test_config} --output-on-failure)
