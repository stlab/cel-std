# Runs an independent source or installed consumer; any failed command is fatal.
# Complexity: O(consumer configuration, compilation, and execution).
function(run)
    execute_process(COMMAND ${ARGV} COMMAND_ERROR_IS_FATAL ANY)
endfunction()

set(root "@CMAKE_CURRENT_BINARY_DIR@/consumer-${MODE}")
set(options
    "-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@"
    "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@"
    "-DCMAKE_CXX_FLAGS=@CMAKE_CXX_FLAGS@"
    "-DCMAKE_EXE_LINKER_FLAGS=@CMAKE_EXE_LINKER_FLAGS@")
set(build_config)
set(test_config)
if(CONFIG)
    list(APPEND build_config --config "${CONFIG}")
    list(APPEND test_config -C "${CONFIG}")
endif()

if(MODE STREQUAL "source")
    list(APPEND options "-DCEL_STD_SOURCE_DIR=@CMAKE_CURRENT_SOURCE_DIR@"
        "-DBUILD_TESTING=OFF" "-DCEL_INSTALL=OFF")
elseif(MODE STREQUAL "installed")
    run("@CMAKE_COMMAND@" --install "@cel-parser_BINARY_DIR@"
        ${build_config} --prefix "${root}/prefix")
    run("@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@"
        ${build_config} --prefix "${root}/prefix")
    list(APPEND options
        "-DCMAKE_PREFIX_PATH=${root}/prefix"
        "-DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF"
        "-DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF")
else()
    message(FATAL_ERROR "Unknown consumer mode: ${MODE}")
endif()

run("@CMAKE_COMMAND@" -S "@CMAKE_CURRENT_SOURCE_DIR@/tests/consumer"
    -B "${root}/build" -G "@CMAKE_GENERATOR@" ${options})
run("@CMAKE_COMMAND@" --build "${root}/build" ${build_config} --parallel 2)
run("@CMAKE_CTEST_COMMAND@" --test-dir "${root}/build"
    ${test_config} --output-on-failure)

if(MODE STREQUAL "installed")
    # Reject parser packages predating the runtime layout update.
    set(old_parser_prefix "${root}/old-parser-prefix")
    set(version_probe "${root}/version-probe")
    file(REMOVE_RECURSE "${old_parser_prefix}" "${version_probe}")
    file(COPY "${root}/prefix/" DESTINATION "${old_parser_prefix}")
    include(CMakePackageConfigHelpers)
    write_basic_package_version_file(
        "${old_parser_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/cel-parser/cel-parserConfigVersion.cmake"
        VERSION 1.0.1 COMPATIBILITY SameMajorVersion ARCH_INDEPENDENT)
    file(MAKE_DIRECTORY "${version_probe}")
    file(WRITE "${version_probe}/CMakeLists.txt"
        "cmake_minimum_required(VERSION 3.24)\n"
        "project(parser_version_probe LANGUAGES NONE)\n"
        "find_package(cel-std CONFIG REQUIRED)\n")
    execute_process(COMMAND "@CMAKE_COMMAND@"
        -S "${version_probe}" -B "${version_probe}/build" -G "@CMAKE_GENERATOR@"
        "-DCMAKE_PREFIX_PATH=${old_parser_prefix}"
        "-DCMAKE_FIND_ROOT_PATH=${old_parser_prefix}"
        -DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY
        -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF
        RESULT_VARIABLE version_result OUTPUT_VARIABLE version_output ERROR_VARIABLE version_error)
    if(version_result EQUAL 0 OR NOT "${version_output}${version_error}" MATCHES "cel-parser"
            OR NOT "${version_output}${version_error}" MATCHES "1\\.0\\.2"
            OR NOT "${version_output}${version_error}" MATCHES "1\\.0\\.1")
        message(FATAL_ERROR
            "Installed cel-std must reject parser 1.0.1:\n${version_output}${version_error}")
    endif()
endif()
